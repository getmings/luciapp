msgid "Control"
msgstr "管控"

msgid "Time Control"
msgstr "时间控制"

msgid "Internet Time Control"
msgstr "上网时间控制"

msgid "Users can limit their internet usage time through MAC and IP, with available IP ranges such as 192.168.110.00 to 192.168.10.200"
msgstr "用户可以通过MAC和IP限制其上网时间，可用IP范围如192.168.110.00至192.168.10.200"

msgid "Suggested feedback:"
msgstr "问题反馈:"

msgid "Checking service status..."
msgstr "正在检查服务状态..."

msgid "Status check failed"
msgstr "状态检查失败"

msgid "RUNNING"
msgstr "运行中"

msgid "NOT RUNNING"
msgstr "未运行"

msgid "TimeControl Service"
msgstr "时间控制服务"

msgid "Control Mode"
msgstr "控制模式"

msgid "blacklist: Block the networking of the target address, whitelist: Only allow networking for the target address and block all other addresses."
msgstr "黑名单：阻断目标地址的上网；白名单：仅允许目标地址上网，阻断其他所有地址。"

msgid "Blacklist"
msgstr "黑名单"

msgid "Whitelist"
msgstr "白名单"

msgid "Control Intensity"
msgstr "控制强度"

msgid "Pay attention to strong control: machines under control will not be able to connect to the software router backend!"
msgstr "注意强控制：被控制的机器将无法连接软件路由器后台！"

msgid "Ordinary forward control"
msgstr "普通管制"

msgid "Strong input control"
msgstr "强力管制"

msgid "Device Rules"
msgstr "设备规则"

msgid "Comment"
msgstr "备注"

msgid "Description"
msgstr "描述"

msgid "Enabled"
msgstr "启用"

msgid "IP/MAC Address"
msgstr "IP/MAC地址"

msgid "192.168.10.100 or 00:11:22:33:44:55"
msgstr "192.168.10.100 或 00:11:22:33:44:55"

msgid "-- Please select or enter manually --"
msgstr "-- 请选择或手动输入 --"

msgid "Start Control Time"
msgstr "控制开始时间"

msgid "00:00"
msgstr "00:00"

msgid "Stop Control Time"
msgstr "控制结束时间"

msgid "Week Day (1~7)"
msgstr "星期（1~7）"

msgid "Everyday"
msgstr "每天"

msgid "Monday"
msgstr "星期一"

msgid "Tuesday"
msgstr "星期二"

msgid "Wednesday"
msgstr "星期三"

msgid "Thursday"
msgstr "星期四"

msgid "Friday"
msgstr "星期五"

msgid "Saturday"
msgstr "星期六"

msgid "Sunday"
msgstr "星期日"

msgid "Workday"
msgstr "工作日"

msgid "Rest Day"
msgstr "休息日"

msgid "© github "
msgstr "© 作者 "

msgid "Time Control Mode"
msgstr "时间控制方式"

msgid "Time Period Control (allow in period)"
msgstr "时间段控制（时间段内允许上网）"

msgid "Allow Duration Control (allow limited time)"
msgstr "时长控制（允许上网指定时长）"

msgid "Combined Control (allow in period + limit duration)"
msgstr "组合控制（时间段内 + 时长限制）"

msgid "Allow Start Time"
msgstr "允许开始时间"

msgid "Allow End Time"
msgstr "允许结束时间"

msgid "Allowed Duration (minutes)"
msgstr "允许时长（分钟）"

msgid "Reset Cycle"
msgstr "重置周期"

msgid "Daily Reset"
msgstr "每天重置"

msgid "Weekly Reset"
msgstr "每周重置"

msgid "Monthly Reset"
msgstr "每月重置"

msgid "Never Reset (until manual reset)"
msgstr "不重置（直到手动重置）"

msgid "Enable Duration Limit in Period"
msgstr "时间段内启用时长限制"

msgid "Clear Logs"
msgstr "清空日志"

msgid "Clear Logs..."
msgstr "正在清空日志..."

msgid "Logs cleared successfully!"
msgstr "日志已清空！"

msgid "Failed to clear log."
msgstr "清空日志失败。"

msgid "Log is clean."
msgstr "日志为空。"

msgid "Log file does not exist."
msgstr "日志文件不存在。"

msgid "Unknown error: %s"
msgstr "未知错误：%s"

msgid "Refresh every 5 seconds."
msgstr "每 5 秒自动刷新。"

msgid "Collecting data ..."
msgstr "正在收集数据..."

msgid "Loading..."
msgstr "加载中..."

msgid "Permission denied. Please re-login to LuCI (or run: /etc/init.d/rpcd restart) and refresh."
msgstr "权限不足，请重新登录 LuCI（或执行 /etc/init.d/rpcd restart）后刷新页面。"

msgid "Log"
msgstr "日志"

msgid "Log Level"
msgstr "日志级别"

msgid "Silent"
msgstr "静默"

msgid "Info"
msgstr "信息"

msgid "All (Debug)"
msgstr "全部（调试）"

msgid "Silent: no logs. Info: only key events (default, less log). All: include debug messages. The log is cleared automatically every 3 days."
msgstr "静默：不记录日志。信息：仅记录关键事件（默认，日志少）。全部：包含调试信息。日志每 3 天自动清理一次。"

msgid "Enabled Devices Status"
msgstr "已启用设备状态"

msgid "Shows whether each enabled device is currently allowed to access the internet. Refreshes automatically."
msgstr "显示每台已启用设备当前是否允许上网，自动刷新。"

msgid "Internet Access"
msgstr "上网状态"

msgid "Reason"
msgstr "原因"

msgid "Allowed"
msgstr "允许上网"

msgid "Blocked"
msgstr "禁止上网"

msgid "Waiting for check"
msgstr "等待检查"

msgid "Service not running"
msgstr "服务未运行"

msgid "No enabled devices."
msgstr "没有已启用的设备。"

msgid "Time format must be HH:MM (00:00 - 23:59)"
msgstr "时间格式必须为 HH:MM（00:00 - 23:59）"

msgid "%s to %s"
msgstr "%s至%s"

msgid ", "
msgstr "、"

msgid "Add rule"
msgstr "添加规则"

msgid "Additionally limit the total online time inside the allowed window."
msgstr "在允许的时间段内，额外限制累计上网时长。"

msgid "All day"
msgstr "全天"

msgid "Allow a limited online time after the device connects"
msgstr "设备上线后允许上网指定时长"

msgid "Allow inside the time window and also limit online time"
msgstr "时间段内允许上网，并限制上网时长"

msgid "Allow internet only inside the set time window"
msgstr "仅在设定时间段内允许上网"

msgid "Combined Control"
msgstr "组合控制"

msgid "Duration Control"
msgstr "时长控制"

msgid "Each rule limits one device. Click the edit button to change time, duration and weekdays."
msgstr "每条规则控制一台设备。点击“编辑”可修改时间段、时长和星期。"

msgid "Edit Device Rule"
msgstr "编辑设备规则"

msgid "Mon"
msgstr "周一"

msgid "Tue"
msgstr "周二"

msgid "Wed"
msgstr "周三"

msgid "Thu"
msgstr "周四"

msgid "Fri"
msgstr "周五"

msgid "Sat"
msgstr "周六"

msgid "Sun"
msgstr "周日"

msgid "Weekend"
msgstr "周末"

msgid "Global Settings"
msgstr "全局设置"

msgid "How often the used time is reset."
msgstr "已用时长按此周期清零。"

msgid "IP or MAC (select or type)"
msgstr "IP 或 MAC（可选择或手动输入）"

msgid "Inside the allowed time window, additionally limit the total online time."
msgstr "在允许的时间段内，再叠加上网时长限制。"

msgid "Limit internet time for each device by IP or MAC address. Rules below apply in blacklist mode."
msgstr "通过 IP 或 MAC 地址为每台设备设置上网时间。以下规则适用于黑名单模式。"

msgid "Minutes the device may stay online; it is blocked once used up."
msgstr "设备允许在线的分钟数，用完后将被禁止上网。"

msgid "Never resets"
msgstr "不自动重置"

msgid "Once online the device may use the network for a set time, then it is blocked."
msgstr "设备上线后可上网指定时长，超过后禁止上网。"

msgid "Online %s – %s"
msgstr "可上网 %s – %s"

msgid "Please enter an IP, MAC or CIDR address"
msgstr "请输入 IP、MAC 或 CIDR 地址"

msgid "Resets daily"
msgstr "每日重置"

msgid "Resets weekly"
msgstr "每周重置"

msgid "Resets monthly"
msgstr "每月重置"

msgid "Rule Summary"
msgstr "规则摘要"

msgid "Start and end equal means all day. Overnight ranges such as 22:00 – 06:00 are supported."
msgstr "开始与结束时间相同表示全天；支持跨天，如 22:00 – 06:00。"

msgid "The device can go online only inside the set time window and is blocked at other times."
msgstr "设备只能在设定的时间段内上网，其余时间禁止上网。"

msgid "The rule above applies only on the selected days; the device is blocked on all other days."
msgstr "上述规则仅在所选星期生效，其余日期将禁止上网。"

msgid "Time Period Control"
msgstr "时间段控制"

msgid "Up to %s min"
msgstr "最长 %s 分钟"

msgid "A single IP, a MAC address or an IP range like 192.168.10.20-192.168.10.30 may be entered manually."
msgstr "可手动输入单个 IP、MAC 地址，或 IP 范围，如 192.168.10.20-192.168.10.30。"

msgid "Add Device Rule"
msgstr "添加设备规则"

msgid "Allow Duration Control"
msgstr "时长控制"

msgid "Allow access inside the time period and additionally limit the duration within it."
msgstr "时间段内允许上网，并在其中限制上网时长。"

msgid "Allow internet access for the given amount of minutes after the device goes online."
msgstr "设备上线后允许上网指定分钟数。"

msgid "Allow internet access only inside the configured time period."
msgstr "仅在设定的时间段内允许上网。"

msgid "Also limit the total online duration inside the allowed time period."
msgstr "在允许的时间段内，额外限制累计上网时长。"

msgid "Block the networking of the listed addresses."
msgstr "阻断列表中地址的上网。"

msgid "Combined control: limit the duration inside the allowed time period."
msgstr "组合控制：在允许的时间段内限制上网时长。"

msgid "Controlled devices can no longer reach the router itself either."
msgstr "被控制的设备也将无法访问路由器本身。"

msgid "Daily"
msgstr "每天"

msgid "Weekly"
msgstr "每周"

msgid "Monthly"
msgstr "每月"

msgid "Never"
msgstr "从不"

msgid "Days on which the rule applies, e.g. 1,2,3,4,5 for workdays."
msgstr "规则生效的星期，例如 1,2,3,4,5 表示工作日。"

msgid "Do not write any log entries."
msgstr "不记录任何日志。"

msgid "Duration control: internet access is allowed for a limited number of minutes."
msgstr "时长控制：允许上网指定的分钟数。"

msgid "End of the time period in which internet access is allowed."
msgstr "允许上网时间段的结束时间。"

msgid "Global behaviour of the time control service."
msgstr "时间控制服务的全局行为。"

msgid "How often the used duration counter is reset."
msgstr "已用时长计数的重置周期。"

msgid "Include debug messages, log grows fast."
msgstr "包含调试信息，日志增长较快。"

msgid "Minutes of internet access after the device goes online, access is blocked afterwards."
msgstr "设备上线后允许上网的分钟数，超过后将被禁止上网。"

msgid "Never reset automatically, reset manually instead."
msgstr "不自动重置，需手动重置。"

msgid "Only allow the listed addresses, block everything else."
msgstr "仅允许列表中的地址上网，阻断其他所有地址。"

msgid "Only internet access is controlled, the device can still reach the router."
msgstr "仅控制上网，设备仍可访问路由器。"

msgid "Only key events, recommended for daily use."
msgstr "仅记录关键事件，日常使用推荐。"

msgid "Reset the counter every day."
msgstr "每天重置计数。"

msgid "Reset the counter every week."
msgstr "每周重置计数。"

msgid "Reset the counter every month."
msgstr "每月重置计数。"

msgid "Start of the time period in which internet access is allowed."
msgstr "允许上网时间段的开始时间。"

msgid "The log is cleared automatically every 3 days."
msgstr "日志每 3 天自动清理一次。"

msgid "Time period control: internet access is only allowed inside the configured period."
msgstr "时间段控制：仅在设定的时间段内允许上网。"

msgid "never reset"
msgstr "不重置"

msgid "reset daily"
msgstr "每日重置"

msgid "reset weekly"
msgstr "每周重置"

msgid "reset monthly"
msgstr "每月重置"

msgid "up to %s minutes"
msgstr "最长 %s 分钟"
