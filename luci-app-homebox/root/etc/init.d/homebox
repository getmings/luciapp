#!/bin/sh /etc/rc.common

START=99
USE_PROCD=1

PROG=/usr/bin/homebox

start_service() {
	config_load homebox

	local enabled
	local port

	config_get_bool enabled config enabled 0
	config_get port config port 3300

	[ "$enabled" = "1" ] || return 0
	[ -n "$port" ] || port=3300

	procd_open_instance
	procd_set_param command "$PROG" serve --host 0.0.0.0 --port "$port"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger homebox
}
